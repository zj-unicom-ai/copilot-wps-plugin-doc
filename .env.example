# Development server port (optional; default 3890)
VITE_DEV_PORT=3890

# Dev server bind address (optional; default 127.0.0.1).
# Must be reachable as 127.0.0.1 for `wpsjs debug` health checks.
# Use 0.0.0.0 only when you need LAN access. Never expose the LLM proxy on a public network.
# VITE_DEV_HOST=127.0.0.1

# Optional fallback LLM proxy target when X-LLM-Target-Origin header is absent.
# In normal dev usage you do NOT need this — the app auto-proxies cross-origin API URLs.
# VITE_LLM_PROXY_TARGET=https://api.openai.com
